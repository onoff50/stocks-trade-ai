# Copy to ~/.stocks-trade-ai/.env (chmod 600) and fill in.
# Generated by `stocks-trade-ai setup`; or hand-edit if you prefer.

# Required: Groww API credentials (TOTP flow)
GROWW_API_KEY=
GROWW_TOTP_SECRET=

# Optional overrides
# DASHBOARD_BIND=127.0.0.1:8080
# STATE_DIR=~/.stocks-trade-ai/state
# LOG_LEVEL=INFO

# Risk caps (defaults shown)
# RISK_ADV_CAP_PCT=10
# RISK_PER_CHILD_PCT_OF_5MIN_VOLUME=1
# RISK_SLIPPAGE_BPS=30
